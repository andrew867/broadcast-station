<configuration>
  <paths>
    <media-path>/workspace/media/</media-path>
    <log-path>/workspace/logs/</log-path>
    <data-path>/workspace/data/</data-path>
    <template-path>/workspace/templates/</template-path>
  </paths>
  <log-level>warning</log-level>
  <ffmpeg>
    <consumer>
      <video-buffer-frames>64</video-buffer-frames>
    </consumer>
    <producer>
      <threads>2</threads>
      <auto-deinterlace>none</auto-deinterlace>
      <live-camera-latest>true</live-camera-latest>
    </producer>
  </ffmpeg>
  <channels>
    <channel>
      <video-mode>2160p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>2160p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>2160p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>720p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>720p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>720p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>720p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>720p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>720p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>720p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>720p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
