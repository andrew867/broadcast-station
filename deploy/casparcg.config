      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
    <channel>
      <video-mode>1080p3000</video-mode>
      <color-depth>8</color-depth>
      <color-space>bt709</color-space>
      <consumers /></channel>
  </channels>
  <controllers>
    <tcp>
      <port>5250</port>
      <protocol>AMCP</protocol>
    </tcp>
  </controllers>
  <html>
    <enable-gpu>true</enable-gpu>
    <angle-backend>gl</angle-backend>
    <remote-debugging-port>9222</remote-debugging-port>
    <cache-path>/tmp/skycam-cef</cache-path>
  </html>
  <osc>
    <default-port>6250</default-port>
  </osc>
</configuration>